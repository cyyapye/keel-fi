{
  "name": "keel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-backed operating system for private holdings and liquidity planning.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "angellist:agent": "tsx scripts/angellist-mac-agent.ts serve",
    "angellist:run": "tsx scripts/angellist-mac-agent.ts run",
    "angellist:setup": "tsx scripts/angellist-mac-agent.ts setup",
    "provider:agent": "tsx scripts/provider-portfolio-mac-agent.ts once",
    "provider:run": "tsx scripts/provider-portfolio-mac-agent.ts run",
    "provider:setup": "tsx scripts/provider-portfolio-mac-agent.ts setup",
    "queue:dlq": "tsx scripts/ingestion-dlq-redrive.ts",
    "build": "pnpm -r build",
    "check": "pnpm data:scan && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "data:scan": "node scripts/check-public-data.mjs",
    "db:check:local": "tsx scripts/local-seed-scenarios.ts check",
    "db:migrate:local": "tsx scripts/local-seed-scenarios.ts migrate",
    "db:reset:local": "tsx scripts/local-seed-scenarios.ts reset",
    "db:scenarios:local": "tsx scripts/local-seed-scenarios.ts list",
    "db:seed:local": "tsx scripts/local-seed-scenarios.ts ensure",
    "dev": "tsx scripts/dev.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node --max-old-space-size=4096 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "local:acceptance:apply": "tsx scripts/local-acceptance-profile.ts apply",
    "local:acceptance:clean": "tsx scripts/local-acceptance-profile.ts clean",
    "local:acceptance:invariants": "tsx scripts/local-acceptance-invariants.ts",
    "local:acceptance:restore": "tsx scripts/local-acceptance-profile.ts restore",
    "test": "vitest run",
    "test:live:sources": "tsx scripts/live-company-source-smoke.ts",
    "test:e2e": "playwright test",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --filter './apps/**' --filter './packages/**' run typecheck && tsc --noEmit -p e2e/ui-catalogue/tsconfig.json",
    "docs:api": "tsx scripts/owner-api-docs.ts",
    "eval:owner": "vitest run scripts/owner-api-eval.test.ts scripts/owner-api-docs.test.ts scripts/grade-owner-answers.test.ts apps/api/src/agent-api/outlook.test.ts scripts/agent-outlook-d1-cost.test.ts",
    "eval:owner:packet": "KEEL_WRITE_OWNER_EVAL_PACKET=1 vitest run scripts/owner-api-eval.test.ts",
    "eval:owner:grade": "tsx scripts/grade-owner-answers.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "aws4fetch": "1.0.20",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jose": "^6.2.4",
    "miniflare": "4.20260721.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "wrangler": "4.113.0",
    "zod": "^4.0.10"
  }
}
