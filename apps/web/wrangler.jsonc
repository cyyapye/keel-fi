{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "services": [
    {
      "binding": "API",
      "service": "keel-api",
    },
  ],
}
