{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-preview-api-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "preview",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_PREVIEW_D1_DATABASE_NAME",
      "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "REPLACE_WITH_PREVIEW_R2_BUCKET_NAME",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "REPLACE_WITH_PREVIEW_QUEUE_NAME",
      },
    ],
    "consumers": [
      {
        "queue": "REPLACE_WITH_PREVIEW_QUEUE_NAME",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
