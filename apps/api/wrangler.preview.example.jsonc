{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keel-preview-api-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "preview",
    "INVESTMENTS_NEW_CONNECTIONS_ENABLED": "true",
    "DEPLOYED_GIT_SHA": "REPLACE_WITH_FULL_DEPLOYED_GIT_SHA",
    "PLAID_WEBHOOK_URL": "https://REPLACE_WITH_PREVIEW_WEBHOOK_HOSTNAME/webhooks/plaid",
  },
  "secrets": {
    "required": [
      "ACCESS_AUD",
      "ACCESS_TEAM_DOMAIN",
      "CONNECTOR_CREDENTIAL_KEY",
      "DEPLOYMENT_SMOKE_TOKEN",
      "PLAID_CLIENT_ID",
      "PLAID_ENVIRONMENT",
      "PLAID_REDIRECT_URI",
      "PLAID_SECRET",
    ],
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_PREVIEW_D1_DATABASE_NAME",
      "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "REPLACE_WITH_PREVIEW_R2_BUCKET_NAME",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "REPLACE_WITH_PREVIEW_QUEUE_NAME",
      },
    ],
    "consumers": [
      {
        "queue": "REPLACE_WITH_PREVIEW_QUEUE_NAME",
        "dead_letter_queue": "REPLACE_WITH_PREVIEW_DLQ_NAME",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
